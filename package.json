{
  "name": "obsidian-pm-insights",
  "version": "0.2.4",
  "private": true,
  "description": "Read-only assignee workload insights for the Obsidian Project Manager plugin.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit && npm run lint && npm run test:official-review && npm test && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:ui:headers": "node scripts/check-task-header-spacing.mjs",
    "test:ui:member-ratios": "node scripts/check-member-ratios.mjs",
    "test:ui:project-picker": "node scripts/check-project-picker-dismiss.mjs",
    "test:ui:task-filters": "node scripts/check-task-filters.mjs",
    "test:ui:task-filter-overflow": "node scripts/check-task-filter-overflow.mjs",
    "test:ui:task-navigation": "node scripts/check-task-navigation.mjs",
    "test:official-review": "node scripts/check-official-review.mjs"
  },
  "keywords": [
    "obsidian",
    "project-manager",
    "workload",
    "assignee",
    "time-tracking"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "latest",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
